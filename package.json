{
  "name": "cc-sdd-vscode",
  "displayName": "cc-sdd Specs",
  "description": "Spec-Driven Development workbench for cc-sdd: spec explorer, approval gates, and task board for .kiro/specs.",
  "version": "0.9.0",
  "publisher": "gotalab",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Tomatio13/cc-sdd-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cc-sdd",
    "sdd",
    "spec-driven",
    "kiro",
    "agent"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/.kiro/specs/*/spec.json",
    "onView:ccSdd.specs",
    "onCommand:ccSdd.refresh"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccSdd",
          "title": "cc-sdd",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ccSdd": [
        {
          "id": "ccSdd.specs",
          "name": "Specs"
        },
        {
          "id": "ccSdd.tasks",
          "name": "Tasks"
        },
        {
          "id": "ccSdd.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ccSdd.specs",
        "contents": "No cc-sdd specs found.\n[Create a spec](command:ccSdd.newSpec)\n[Install cc-sdd](command:ccSdd.install)\n[Refresh](command:ccSdd.refresh)"
      },
      {
        "view": "ccSdd.tasks",
        "contents": "Select a spec in the Specs view to see its tasks."
      },
      {
        "view": "ccSdd.sessions",
        "contents": "No sessions for this project yet.\nRuns started with agent `claude-console` are recorded here and can be resumed."
      }
    ],
    "commands": [
      {
        "command": "ccSdd.refresh",
        "title": "cc-sdd: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ccSdd.newSpec",
        "title": "cc-sdd: New Spec",
        "icon": "$(add)"
      },
      {
        "command": "ccSdd.runDiscovery",
        "title": "cc-sdd: Run Discovery",
        "icon": "$(compass)"
      },
      {
        "command": "ccSdd.runSteering",
        "title": "cc-sdd: Run Steering",
        "icon": "$(sync)"
      },
      {
        "command": "ccSdd.runValidateGap",
        "title": "cc-sdd: Validate against Codebase (Gap)"
      },
      {
        "command": "ccSdd.runValidateDesign",
        "title": "cc-sdd: Validate Design"
      },
      {
        "command": "ccSdd.openPath",
        "title": "Open Path"
      },
      {
        "command": "ccSdd.install",
        "title": "cc-sdd: Install Skills",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ccSdd.pickSpec",
        "title": "cc-sdd: Select Active Spec",
        "icon": "$(list-selection)"
      },
      {
        "command": "ccSdd.showStatus",
        "title": "cc-sdd: Show Spec Status",
        "icon": "$(info)"
      },
      {
        "command": "ccSdd.selectSpec",
        "title": "Select Spec",
        "icon": "$(check)"
      },
      {
        "command": "ccSdd.openSpecJson",
        "title": "Open spec.json",
        "icon": "$(json)"
      },
      {
        "command": "ccSdd.openArtifact",
        "title": "Open Artifact",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ccSdd.runPhase",
        "title": "Run Phase",
        "icon": "$(play)"
      },
      {
        "command": "ccSdd.approvePhase",
        "title": "Approve Phase",
        "icon": "$(check)"
      },
      {
        "command": "ccSdd.revokePhase",
        "title": "Revoke Approval",
        "icon": "$(discard)"
      },
      {
        "command": "ccSdd.runImpl",
        "title": "Run Implementation",
        "icon": "$(rocket)"
      },
      {
        "command": "ccSdd.runValidateImpl",
        "title": "cc-sdd: Run Implementation Validation",
        "icon": "$(shield)"
      },
      {
        "command": "ccSdd.openValidation",
        "title": "Open Validation Report",
        "icon": "$(file)"
      },
      {
        "command": "ccSdd.openSpecRun",
        "title": "Open Run",
        "icon": "$(play)"
      },
      {
        "command": "ccSdd.runTask",
        "title": "Run This Task",
        "icon": "$(play)"
      },
      {
        "command": "ccSdd.runFromTask",
        "title": "Run From This Task",
        "icon": "$(run-all)"
      },
      {
        "command": "ccSdd.openSessionRun",
        "title": "Open Related Run",
        "icon": "$(play)"
      },
      {
        "command": "ccSdd.toggleSessionScope",
        "title": "cc-sdd: Toggle Sessions Scope",
        "icon": "$(list-unordered)"
      },
      {
        "command": "ccSdd.openTask",
        "title": "Open Task",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ccSdd.toggleTask",
        "title": "Toggle Task",
        "icon": "$(check)"
      },
      {
        "command": "ccSdd.runs",
        "title": "cc-sdd: Show Runs Console",
        "icon": "$(console)"
      },
      {
        "command": "ccSdd.overview",
        "title": "cc-sdd: Open Overview",
        "icon": "$(dashboard)"
      },
      {
        "command": "ccSdd.saveRunTrace",
        "title": "cc-sdd: Save Last Run Trace",
        "icon": "$(save-as)"
      },
      {
        "command": "ccSdd.resumeSession",
        "title": "cc-sdd: Resume Session",
        "icon": "$(debug-start)"
      },
      {
        "command": "ccSdd.previewSession",
        "title": "cc-sdd: Preview Session Transcript",
        "icon": "$(preview)"
      },
      {
        "command": "ccSdd.refreshSessions",
        "title": "cc-sdd: Refresh Sessions",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ccSdd.overview",
          "when": "view == ccSdd.specs || view == ccSdd.tasks || view == ccSdd.sessions",
          "group": "navigation@0"
        },
        {
          "command": "ccSdd.runDiscovery",
          "when": "view == ccSdd.specs",
          "group": "navigation@1"
        },
        {
          "command": "ccSdd.newSpec",
          "when": "view == ccSdd.specs",
          "group": "navigation@2"
        },
        {
          "command": "ccSdd.install",
          "when": "view == ccSdd.specs",
          "group": "navigation@3"
        },
        {
          "command": "ccSdd.refresh",
          "when": "view == ccSdd.specs || view == ccSdd.tasks",
          "group": "navigation@4"
        },
        {
          "command": "ccSdd.refreshSessions",
          "when": "view == ccSdd.sessions",
          "group": "navigation@1"
        },
        {
          "command": "ccSdd.toggleSessionScope",
          "when": "view == ccSdd.sessions",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "ccSdd.selectSpec",
          "when": "view == ccSdd.specs && viewItem =~ /^spec/",
          "group": "navigation@1"
        },
        {
          "command": "ccSdd.runValidateGap",
          "when": "view == ccSdd.specs && viewItem =~ /^spec/",
          "group": "navigation@2"
        },
        {
          "command": "ccSdd.runValidateDesign",
          "when": "view == ccSdd.specs && viewItem =~ /^spec/",
          "group": "navigation@3"
        },
        {
          "command": "ccSdd.openSpecJson",
          "when": "view == ccSdd.specs && viewItem =~ /^spec/",
          "group": "inline@1"
        },
        {
          "command": "ccSdd.runSteering",
          "when": "view == ccSdd.specs && viewItem =~ /^steering/",
          "group": "inline@1"
        },
        {
          "command": "ccSdd.runSteering",
          "when": "view == ccSdd.specs && viewItem =~ /^steering/",
          "group": "navigation@1"
        },
        {
          "command": "ccSdd.runImpl",
          "when": "view == ccSdd.specs && viewItem == impl-in-progress",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.openSpecRun",
          "when": "view == ccSdd.specs && viewItem == impl-running",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.openSpecRun",
          "when": "view == ccSdd.specs && viewItem == verification-running",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.runValidateImpl",
          "when": "view == ccSdd.specs && viewItem =~ /^verification-(none|failed|stale|manual|unconfirmed|error)$/",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.openValidation",
          "when": "view == ccSdd.specs && viewItem =~ /^verification-(verified|failed|stale|manual|unconfirmed|error)$/",
          "group": "inline@1"
        },
        {
          "command": "ccSdd.openArtifact",
          "when": "view == ccSdd.specs && viewItem =~ /^phase-/",
          "group": "inline@1"
        },
        {
          "command": "ccSdd.runPhase",
          "when": "view == ccSdd.specs && viewItem =~ /^phase-(missing|draft|generated)$/",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.approvePhase",
          "when": "view == ccSdd.specs && viewItem =~ /^phase-(draft|generated)$/",
          "group": "inline@3"
        },
        {
          "command": "ccSdd.revokePhase",
          "when": "view == ccSdd.specs && viewItem == phase-approved",
          "group": "inline@3"
        },
        {
          "command": "ccSdd.openTask",
          "when": "view == ccSdd.tasks && viewItem =~ /^task/",
          "group": "navigation@1"
        },
        {
          "command": "ccSdd.toggleTask",
          "when": "view == ccSdd.tasks && viewItem =~ /^task/",
          "group": "inline@1"
        },
        {
          "command": "ccSdd.runTask",
          "when": "view == ccSdd.tasks && viewItem == task-todo",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.runFromTask",
          "when": "view == ccSdd.tasks && viewItem == task-todo",
          "group": "inline@3"
        },
        {
          "command": "ccSdd.openSpecRun",
          "when": "view == ccSdd.tasks && viewItem == task-running",
          "group": "inline@2"
        },
        {
          "command": "ccSdd.resumeSession",
          "when": "view == ccSdd.sessions && viewItem == session-history",
          "group": "inline@1"
        },
        {
          "command": "ccSdd.openSessionRun",
          "when": "view == ccSdd.sessions && viewItem == session-active-run",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ccSdd.selectSpec",
          "when": "false"
        },
        {
          "command": "ccSdd.openSpecJson",
          "when": "false"
        },
        {
          "command": "ccSdd.openArtifact",
          "when": "false"
        },
        {
          "command": "ccSdd.runPhase",
          "when": "false"
        },
        {
          "command": "ccSdd.approvePhase",
          "when": "false"
        },
        {
          "command": "ccSdd.revokePhase",
          "when": "false"
        },
        {
          "command": "ccSdd.openTask",
          "when": "false"
        },
        {
          "command": "ccSdd.toggleTask",
          "when": "false"
        },
        {
          "command": "ccSdd.openValidation",
          "when": "false"
        },
        {
          "command": "ccSdd.openSpecRun",
          "when": "false"
        },
        {
          "command": "ccSdd.runTask",
          "when": "false"
        },
        {
          "command": "ccSdd.runFromTask",
          "when": "false"
        },
        {
          "command": "ccSdd.openSessionRun",
          "when": "false"
        },
        {
          "command": "ccSdd.openPath",
          "when": "false"
        },
        {
          "command": "ccSdd.resumeSession",
          "when": "false"
        },
        {
          "command": "ccSdd.previewSession",
          "when": "false"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.kiro/specs/*/spec.json",
        "url": "./schemas/spec.schema.json"
      }
    ],
    "configuration": {
      "title": "cc-sdd",
      "properties": {
        "ccSdd.kiroDir": {
          "type": "string",
          "default": ".kiro",
          "description": "Directory that contains specs/ and settings/, relative to the workspace root."
        },
        "ccSdd.specSort": {
          "type": "string",
          "enum": [
            "newest",
            "roadmap"
          ],
          "enumDescriptions": [
            "Newest specs first, using spec.json created_at (falling back to updated_at).",
            "Follow the dependency order in roadmap.md when available."
          ],
          "default": "newest",
          "description": "Ordering of specs in the Specs view."
        },
        "ccSdd.agent": {
          "type": "string",
          "enum": [
            "claude",
            "claude-vscode",
            "claude-console",
            "codex",
            "copilot",
            "opencode",
            "custom",
            "clipboard"
          ],
          "enumDescriptions": [
            "Run the skill in a Claude Code terminal.",
            "Send the skill prompt to the Claude Code for VS Code panel. The prompt is pre-filled in the composer; press Enter to run it.",
            "Run headless with claude -p and stream progress in the cc-sdd Runs console. Auto-executes; the permission mode is picked per run.",
            "Run the skill in a Codex terminal.",
            "Prefill the skill prompt in Copilot Chat.",
            "Run the skill with `opencode run`.",
            "Use ccSdd.customCommand as the terminal command template.",
            "Copy the skill prompt to the clipboard."
          ],
          "default": "claude",
          "description": "How the extension hands a skill invocation to an agent."
        },
        "ccSdd.customCommand": {
          "type": "string",
          "default": "",
          "description": "Terminal command template used when ccSdd.agent is \"custom\". Placeholders: ${prompt}, ${skill}, ${feature}."
        },
        "ccSdd.installLanguage": {
          "type": "string",
          "default": "",
          "description": "Optional --lang value passed to `npx cc-sdd@latest` (for example: ja, zh-TW). Leave empty to use the installer default."
        },
        "ccSdd.consolePermissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "bypassPermissions",
            "plan"
          ],
          "default": "default",
          "description": "Preselected permission mode for headless runs (ccSdd.agent = claude-console). 'default' asks in the Runs console before gated tools. A picker still asks per run."
        },
        "ccSdd.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the claude CLI binary used for headless runs."
        },
        "ccSdd.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the Specs and Tasks views when files under the specs directory change."
        }
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --log-level=warning \"--define:import.meta.url=__filename\"",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --watch \"--define:import.meta.url=__filename\"",
    "check": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest -w",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --readme-path README.marketplace.md"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
