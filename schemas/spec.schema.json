{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cc-sdd spec.json",
  "description": "Metadata and approval state for a cc-sdd specification.",
  "type": "object",
  "required": ["phase", "approvals"],
  "properties": {
    "feature_name": {
      "type": "string",
      "description": "Human-readable feature name."
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the last metadata update."
    },
    "language": {
      "type": "string",
      "description": "Documentation language code (for example: en, ja, zh-TW)."
    },
    "phase": {
      "type": "string",
      "enum": [
        "initialized",
        "requirements-generated",
        "design-generated",
        "tasks-generated"
      ],
      "description": "Current generation phase. Approval state is tracked separately."
    },
    "approvals": {
      "type": "object",
      "required": ["requirements", "design", "tasks"],
      "properties": {
        "requirements": {
          "$ref": "#/definitions/approval"
        },
        "design": {
          "$ref": "#/definitions/approval"
        },
        "tasks": {
          "$ref": "#/definitions/approval"
        }
      },
      "additionalProperties": false
    },
    "ready_for_implementation": {
      "type": "boolean",
      "description": "True when all three phases are approved."
    }
  },
  "additionalProperties": true,
  "definitions": {
    "approval": {
      "type": "object",
      "required": ["generated", "approved"],
      "properties": {
        "generated": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
